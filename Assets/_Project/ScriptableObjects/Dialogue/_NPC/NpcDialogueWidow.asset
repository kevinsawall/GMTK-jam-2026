  m_Script: {fileID: 11500000, guid: 7b39f30a5c9a46f5a147d5c1f2f4d10b, type: 3}
  m_Name: NpcDialogueWidow
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSO
  npcId: widow-npc
  npcDisplayName: Widow
  portrait: {fileID: 0}
  speakerNameColor: {r: 0.30980393, g: 0.43529412, b: 0.27058825, a: 1}
  entries:
  - entryId: first-talk
    requiredState: 0
    requiredFlag: 
    requiredItem: {fileID: 0}
    lines:
    - speaker: 0
      text: "Travelling on your own, coraz\xF3n?"
    - speaker: 1
      text: Yes. New software job in Mexico City.
    - speaker: 1
      text: "And yes, I\u2019m going on my own."
    - speaker: 0
      text: "Me too. All alone now. Though, wasn\u2019t I alone all my life, even
        with a family?"
    - speaker: 0
      text: "Our child, nuestro ni\xF1o lindo\u2026 He liked to collect things, you
        know?"
    - speaker: 0
      text: "He\u2019d show them to me, then bring them up to the attic, where he\u2019d
        hide."
    - speaker: 0
      text: He died so young.
    - speaker: 1
      text: "I\u2019m so sorry."
    - speaker: 0
      text: "It\u2019s alright, coraz\xF3n. I made peace with it."
    - speaker: 0
      text: "I only wish\u2026 that his father spent more time with him, got to know
        his son."
    - speaker: 0
      text: "We were so crushed\u2026 I barely saw my husband in 20 years, until
        he finally retired."
    - speaker: 0
      text: And on the first day off work he died. A heart attack.
    - speaker: 0
      text: I wish we had more time together.
    - speaker: 0
      text: "Just the two of us with our son, travelling, visiting relatives, living\u2026"
    - speaker: 0
      text: "You\u2019re still so young, ni\xF1a. You probably think I\u2019m a crazy
        old lady."
    - speaker: 1
      text: Oh no, not at all.
    - speaker: 0
      text: "Here, take this. One of my son\u2019s treasures. Keep it as a reminder
        that time flies by."
    - speaker: 1
      text: "Thank you. That\u2019s\u2026 very relevant."
    actions:
    - type: 6
      stringValue: 
      item: {fileID: 11400000, guid: d94b6fda5eff342129682c774ac21818, type: 2}
      nextNpcState: 0
    - type: 4
