  m_Script: {fileID: 11500000, guid: 7b39f30a5c9a46f5a147d5c1f2f4d10b, type: 3}
  m_Name: NpcDialogueWidow
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSO
  npcId: widow-npc
  npcDisplayName: Widow
  portrait: {fileID: 0}
  entries:
  - entryId: first-talk
    requiredState: 0
    requiredFlag: 
    requiredItem: {fileID: 0}
    lines:
    - speaker: 0
      text: "Travelling on your own, corazón?"
    - speaker: 1
      text: "Yes. New software job in Mexico City."
    - speaker: 1
      text: "And yes, I’m going on my own."
    - speaker: 0
      text: "Me too. All alone now. Though, wasn’t I alone all my life, even with a family?"
    - speaker: 0
      text: "Our child, nuestro niño lindo… He liked to collect things, you know?"
    - speaker: 0
      text: "He’d show them to me, then bring them up to the attic, where he’d hide."
    - speaker: 0
      text: "He died so young."
    - speaker: 1
      text: "I’m so sorry."
    - speaker: 0
      text: "It’s alright, corazón. I made peace with it."
    - speaker: 0
      text: "I only wish… that his father spent more time with him, got to know his son."
    - speaker: 0
      text: "We were so crushed… I barely saw my husband in 20 years, until he finally retired."
    - speaker: 0
      text: "And on the first day off work he died. A heart attack."
    - speaker: 0
      text: "I wish we had more time together. Just the two of us with our son, travelling, visiting relatives, living…"
    - speaker: 0
      text: "You’re still so young, niña. You probably think I’m a crazy old lady."
    - speaker: 1
      text: "Oh no, not at all."
    - speaker: 0
      text: "Here, take this. One of my son’s treasures. Keep it as a reminder that time flies by."
    - speaker: 1
      text: "Thank you. That’s… very relevant."
    actions:
