  m_Name: NpcDialogueLuchador
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSO
  npcId: luchador-npc
  npcDisplayName: Luchador
  portrait: {fileID: 0}
  entries:
  - entryId: first-talk
    requiredState: 0
    requiredFlag: 
    requiredItem: {fileID: 0}
    lines:
    - speaker: 1
      text: "Excuse me, I need someone to help me..."
    - speaker: 0
      text: "I am a fighter, that’s everything I am. No one ever needed me to be anything else."
    - speaker: 0
      text: "You should’ve seen the crowds! Thousands chanting my name!"
    - speaker: 0
      text: "They loved me! What more does a man need?"
    actions:
    - type: 4
      stringValue: 
      item: {fileID: 0}
      nextNpcState: 2
  - entryId: waiting-for-item
    requiredState: 2
    requiredFlag: 
    requiredItem: {fileID: 0}
    lines:
    - speaker: 0
      text: "I’m a fighter! Yeah!"
    actions: []
  - entryId: completed
    requiredState: 5
    requiredFlag: 
    requiredItem: {fileID: 0}
    lines:
    - speaker: 0
      text: "I’ll go see my son... when I have the courage."
    actions: []
  skipFirstTalkWhenFlagSet: 
  skippedFirstTalkState: 2
  expectedDroppedItem: {fileID: 11400000, guid: e5189ca137c624c61899108b68fb2247, type: 2}
  correctItemDropDialogue:
    entryId: correct-item-drop
    requiredState: 2
    requiredFlag: 
    requiredItem: {fileID: 0}
    lines:
    - speaker: 0
      text: "...That’s... That’s my family... My niño... My da..."
    - speaker: 0
      text: "I kept telling myself I was a champion. Maybe I was."
    - speaker: 0
      text: "But I wasn’t much of a father."
    - speaker: 0
      text: "Should’ve supported my boy when he said he’d follow in da’s steps."
    - speaker: 0
      text: "Here. This belonged to my da."
    - speaker: 0
      text: "Look at that picture... young as can be. My son must be that age now."
    - speaker: 0
      text: "Da worked those rails his whole life. Never even bothered getting a new photograph."
    - speaker: 0
      text: "Don’t know why I kept it. He hated me."
    - speaker: 0
      text: "Da fell ill, see? The tremors, the memory lapses…"
    - speaker: 0
      text: "He chased me away. I should have stayed. Should have insisted..."
    - speaker: 1
      text: "That’s a lot to remember at once."
    - speaker: 1
      text: "Here’s your dad’s card back."
    - speaker: 0
      text: "No, no. Keep it. I’ll go see my son... when I have the courage."
    actions:
    - type: 3
      stringValue: 
      item: {fileID: 11400000, guid: e5189ca137c624c61899108b68fb2247, type: 2}
      nextNpcState: 0
    - type: 6
      stringValue: 
      item: {fileID: 11400000, guid: c9782c6d627d14a0d8375d49f01cb3be, type: 2}
      nextNpcState: 0
    - type: 4
