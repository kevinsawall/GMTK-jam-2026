  entries:
  - entryId: "first-talk"
    requiredState: 0
    requiredFlag: ""
    requiredItem: {fileID: 0}
    lines:
    - speaker: 0
      text: "Hey! Don’t look! Those are just sketches!"
    - speaker: 1
      text: "Sorry, I didn’t mean to. They are not so bad, though. Have that weekly manga feel to them…"
    - speaker: 0
      text: "They’re terrible! No use finishing them."
    - speaker: 0
      text: "I just need to practice more. That’s how I do those ideas justice."
    - speaker: 0
      text: "Someday, when I’m a real artist, I will finally draw something good."
    - speaker: 0
      text: "Now leave me alone."
