  m_Script: {fileID: 11500000, guid: 7b39f30a5c9a46f5a147d5c1f2f4d10b, type: 3}
  m_Name: NpcDialogueMechanic
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSO
  npcId: mechanic-npc
  npcDisplayName: Mechanic
  portrait: {fileID: 0}
  entries:
  - entryId: first-talk
    requiredState: 0
    requiredFlag: 
    requiredItem: {fileID: 0}
    lines:
    - speaker: 0
      text: "Oh no, oh no, oh no. Something’s wrong. An engine part’s missing."
    - speaker: 0
      text: "I should have listened to my grandda. He used to say the rules are to be followed precisely, but I thought I’d check this later. And now… it’s too late!"
    - speaker: 0
      text: "Oh, grandda… It’s Dia de Muertos, the Day of the Dead, I wonder if I’ll see him…"
    - speaker: 1
      text: "Strangely, there are marigolds all around the train. Should be enough to attract souls of the dead. And the whole altar at the back..."
    - speaker: 0
      text: "That’s my only hope! I’d appreciate his advice now."
    - speaker: 0
      text: "Look at this photo. It’s me, and my grandda’s holding me…"
    - speaker: 0
      text: "My da’s there, too. But he’s never been around much, having his career and all that..."
    - speaker: 1
      text: "That’s great, I mean, sad. But didn’t you say something about a missing train part?"
    - speaker: 0
      text: "Yes! The engine part’s gone! Listen, I can’t leave this unattended, or we’ll crash."
    - speaker: 0
      text: "Help me find this part, I beg you! It should be somewhere on the train. Hurry!"
    actions:
    - type: 6
      stringValue: 
      item: {fileID: 11400000, guid: e5189ca137c624c61899108b68fb2247, type: 2}
      nextNpcState: 0
    - type: 1
