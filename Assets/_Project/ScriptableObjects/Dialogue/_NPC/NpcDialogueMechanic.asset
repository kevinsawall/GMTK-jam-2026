  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7b39f30a5c9a46f5a147d5c1f2f4d10b, type: 3}
  m_Name: NpcDialogueMechanic
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSO
  npcId: mechanic-npc
  npcDisplayName: Mechanic
  portrait: {fileID: 0}
  entries:
  - entryId: first-talk
    requiredState: 0
    requiredFlag: 
    requiredItem: {fileID: 0}
    lines:
    - speaker: 0
      text: "Oh no, oh no, oh no. Something\u2019s wrong. An engine part\u2019s missing."
    - speaker: 0
      text: I should have listened to my grandda. He used to say the rules are to
        be followed precisely.
    - speaker: 0
      text: "But I thought I\u2019d check this later. And now\u2026 it\u2019s too
        late!"
    - speaker: 0
      text: "Oh, grandda\u2026 It\u2019s Dia de Muertos, the Day of the Dead, I wonder
        if I\u2019ll see him\u2026"
    - speaker: 1
      text: Strangely, there are marigolds all around the train. Should be enough
        to attract souls of the dead.
    - speaker: 1
      text: And the whole altar at the back...
    - speaker: 0
      text: "That\u2019s my only hope! I\u2019d appreciate his advice now."
    - speaker: 0
      text: "Look at this photo. It\u2019s me, and my grandda\u2019s holding me\u2026"
    - speaker: 0
      text: "My da\u2019s there, too. But he\u2019s never been around much, having
        his career and all that..."
    - speaker: 1
      text: "That\u2019s great, I mean, sad. But didn\u2019t you say something about
        a missing train part?"
    - speaker: 0
      text: "Yes! The engine part\u2019s gone! Listen, I can\u2019t leave this unattended,
        or we\u2019ll crash."
    - speaker: 0
      text: Help me find this part, I beg you! It should be somewhere on the train.
        Hurry!
    actions:
    - type: 6
      stringValue: 
      item: {fileID: 11400000, guid: e5189ca137c624c61899108b68fb2247, type: 2}
      nextNpcState: 0
    - type: 1
