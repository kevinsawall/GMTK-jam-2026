      text: "Oh no…"
    actions: []
  - entryId: completed
    requiredState: 5
    requiredFlag: 
    requiredItem: {fileID: 0}
    lines:
    - speaker: 0
      text: "That’s it! That’s exactly what I need to repair this!"
    actions: []
