      text: "Oh no\u2026"
    actions: []
  - entryId: completed
    requiredState: 5
    requiredFlag: 
    requiredItem: {fileID: 0}
    lines:
    - speaker: 0
      text: "That\u2019s it! That\u2019s exactly what I need to repair this!"
    actions: []
