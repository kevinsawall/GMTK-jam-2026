  entries:
  - entryId: first-talk
    requiredState: 0
    requiredFlag: ""
    requiredItem: {fileID: 0}
    lines:
    - speaker: 1
      text: "Excuse…"
    - speaker: 0
      text: "I’m sorry, but I’m rather busy."
    - speaker: 1
      text: "This can’t wait…"
    - speaker: 0
      text: "I am a serious person, young lady. I need to take care of my family."
    - speaker: 0
      text: "Unlike some people, I have deadlines to meet."
    actions:
    - type: 4
      stringValue: ""
      item: {fileID: 0}
      nextNpcState: 2
  - entryId: waiting-for-item
    requiredState: 2
    requiredFlag: ""
    requiredItem: {fileID: 0}
    lines:
    - speaker: 0
      text: "Need to finish this first..."
    actions: []
  - entryId: completed
    requiredState: 5
    requiredFlag: ""
    requiredItem: {fileID: 0}
    lines:
    - speaker: 0
      text: "What have I done?!"
    actions: []
  expectedDroppedItem: {fileID: 11400000, guid: d94b6fda5eff342129682c774ac21818, type: 2}
  correctItemDropDialogue:
    entryId: "correct-item-drop"
    requiredState: 2
    requiredFlag: ""
    requiredItem: {fileID: 0}
    lines:
    - speaker: 1
      text: "Since time is your department…"
    - speaker: 0
      text: "Is this… I can’t believe it… It’s our son’s watch!"
    - speaker: 0
      text: "Oh, this brings back so many memories…"
    - speaker: 0
      text: "..."
    - speaker: 0
      text: "Although, I wish there were more memories we made together…"
    - speaker: 0
      text: "I kept telling myself I was working for them."
    - speaker: 0
      text: "Late nights. Weekends."
    - speaker: 0
      text: "One more promotion. One more project."
    - speaker: 0
      text: "My little boy… I miss him so much."
    - speaker: 0
      text: "How did my wife deal with this? I don’t even know!"
    - speaker: 0
      text: "She needed me, and I hid myself in the office day and night, buried myself under all these folders."
    - speaker: 0
      text: "I gave my family everything..."
    - speaker: 0
      text: "...except myself."
    - speaker: 0
      text: "What have I done?!"
    - speaker: 0
      text: "No more work! Take this away from me."
    actions:
    - type: 3
      stringValue: ""
      item: {fileID: 11400000, guid: d94b6fda5eff342129682c774ac21818, type: 2}
      nextNpcState: 0
    - type: 6
      stringValue: ""
      item: {fileID: 11400000, guid: e98d9d804f61b4e1a93748f563957296, type: 2}
      nextNpcState: 0
    - type: 4
